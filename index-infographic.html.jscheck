
(function(){
const $=id=>document.getElementById(id), clamp=(x,a=0,b=1)=>Math.max(a,Math.min(b,x));
const easeOut=x=>1-Math.pow(1-clamp(x),3), easeInOut=x=>x<.5?4*x*x*x:1-Math.pow(-2*x+2,3)/2;
const easeBack=x=>{const c=1.70158;return 1+(c+1)*Math.pow(x-1,3)+c*Math.pow(x-1,2)};
const prog=(t,s,d)=>clamp((t-s)/d);
const moods={respectful:[233,196,106],happy:[255,190,90],informative:[60,200,170],excited:[170,230,80],calm:[110,170,255],enthusiastic:[255,160,70]};
let scenes=[],duration=56.5,envelope=null,fps=30,opts={},theme=document.body.classList.contains('podcast')?'podcast':'infographic',bars=[],particles=[];
function parse(raw){let arr=raw.split(/\r?\n/).filter(x=>x.trim()).map(line=>{let p=line.split('|').map(s=>s.trim());return {start:+p[0],end:+p[1],raw:p[2]||'',mood:moods[p[3]]?p[3]:'happy'}});
for(let i=1;i<arr.length;i++)if(arr[i].start<arr[i-1].end){console.warn('Overlapping scenes; trimming earlier end');arr[i-1].end=arr[i].start}
return arr.map(s=>{let hi=[];let text=s.raw.replace(/❝([^❞]*)❞/g,(_,x)=>{hi.push(x);return x});return {...s,text,hi}})}
function makeCaption(s){let cap=$('caption');cap.innerHTML='';let words=s.text.split(/(\s+)/).filter(Boolean), non=words.filter(w=>! /^\s+$/.test(w)), total=non.reduce((a,w)=>a+w.length+1,0),cum=0;words.forEach(w=>{if(/^\s+$/.test(w)){cap.appendChild(document.createTextNode(w));return}let span=document.createElement('span');span.className='word';span.textContent=w;span.dataset.weight=w.length+1;span.dataset.st=(.15+cum/Math.max(1,total)*Math.max(.6,s.end-s.start-.55));span.dataset.en=+span.dataset.st+Math.max(.12,(w.length+1)/Math.max(1,total)*(s.end-s.start-.55));if(s.hi.some(h=>h.includes(w.replace(/[،۔.!؟,]/g,''))))span.dataset.gold='1';cap.appendChild(span);cum+=w.length+1})}
function visual(s){['arabic','cards','number','badgeWrap','closeEmojis'].forEach(id=>{$(id).style.display='none'});if(theme==='podcast'){['screenArabic','screenCards','screenNumber','screenBadge','screenClose'].forEach(id=>$(id).style.display='none')}
let txt=s.text, greeting=/আসসালামু আলাইকুম/.test(txt), brand=/ইসলামী বিশ্বকোষ ও আল হাদিস S2/.test(txt), store=/প্লে স্টোর|ইনস্টল করুন/.test(txt), closing=/নিজে পড়ুন/.test(txt);
let target=theme==='podcast'?'screenContent':'visual';
if(greeting){$(theme==='podcast'?'screenArabic':'arabic').style.display='block'}
else if(store){if(theme==='podcast')$('screenBadge').style.display='block';else $('badgeWrap').style.display='flex';}
else if(closing){if(theme==='podcast')$('screenClose').style.display='block';else $('closeEmojis').style.display='block'}
else{
let cards=[]; if(/,| ও | এবং | সাথে /.test(txt)){let parts=txt.replace(/[।,]/g,'').split(/,| ও | এবং | সাথে /).map(x=>x.trim()).filter(x=>x.length>2);cards=parts.slice(0,3)}
if(cards.length){let box=$(theme==='podcast'?'screenCards':'cards');box.style.display='flex';box.innerHTML='';cards.forEach((c,i)=>{let d=document.createElement('div');d.className='vcard';d.innerHTML='<div class="emoji">📚</div><div class="label"></div>';d.querySelector('.label').textContent=c;d.style.transform='translateX(80px)';box.appendChild(d)})}
let num=txt.match(/পঁয়তাল্লিশটি|দুই লক্ষ সত্তর হাজার তিনশো পঁয়ত্রিশটি|আটশত|এক হাজার/);if(num){let n=num[0],val=n==='পঁয়তাল্লিশটি'?'৪৫':n==='দুই লক্ষ সত্তর হাজার তিনশো পঁয়ত্রিশটি'?'২,৭০,৩৩৫':n==='আটশত'?'৮০০+':'১,০০০+';$ (theme==='podcast'?'screenNumber':'number').textContent=val;$(theme==='podcast'?'screenNumber':'number').style.display='block'}
}
}
function init(raw,options={}){opts=options; if(!opts.badge){$('badge').style.display='none';$('fallback').style.display='block';$('screenBadge').querySelector('img').style.display='none';$('screenBadge').querySelector('div').textContent='▶ ইনস্টল করুন';} scenes=parse(raw);duration=(scenes.length?scenes[scenes.length-1].end:0)+.5;
particles=[];for(let i=0;i<38;i++){let e=document.createElement('i');e.className='particle';$('particles').appendChild(e);particles.push(e)}
bars=[];let eq=$('eq');eq.innerHTML='';for(let i=0;i<(theme==='podcast'?40:30);i++){let e=document.createElement('i');e.className='bar';eq.appendChild(e);bars.push(e)}
if(theme==='podcast'){$('onair').style.display='block';let dec=$('studioDecor');dec.innerHTML='';for(let i=0;i<8;i++){let x=1030+(i%4)*215,y=150+Math.floor(i/4)*280;let el=document.createElement('div');el.style.cssText=`position:absolute;left:${x}px;top:${y}px;width:190px;height:245px;border-radius:18px;background:repeating-linear-gradient(90deg,#0b281a 0 18px,#123b27 18px 22px);border:2px solid #1e5c3a`;dec.appendChild(el)}}
return duration}
function fit(){let cap=$('caption'),size=theme==='podcast'?(cap.textContent.length<=50?64:56):(cap.textContent.length<=40?72:cap.textContent.length<=90?66:cap.textContent.length<=130?56:50);let min=theme==='podcast'?34:40;cap.style.fontSize=size+'px';while((cap.scrollHeight>cap.clientHeight||cap.scrollWidth>cap.clientWidth)&&size>min){size-=2;cap.style.fontSize=size+'px'}return {caption:size}}
function setAudio(env,f){envelope=env;fps=f||30}
function level(t){return envelope&&envelope.length?clamp(envelope[Math.floor(t*fps)%envelope.length]):clamp(.38+.2*Math.sin(3.1*t)+.12*Math.sin(7.7*t+1))}
function seek(t){let s=scenes.find(x=>t>=x.start-.01&&t<=x.end+.01),lv=level(t),sp=0;
if(s){sp=1;let local=t-s.start,enter=easeOut(prog(t,s.start-.01,.45)),exit=s===scenes[scenes.length-1]?1:1-easeOut(prog(t,s.end-.3,.3));let op=enter*exit;document.body.style.setProperty('--mood',(moods[s.mood]||moods.happy).join(','));makeCaption(s);visual(s);$('caption').style.opacity=op;$('caption').style.transform=`translateY(${40*(1-enter)}px)`;document.querySelectorAll('.word').forEach(w=>{let st=+w.dataset.st,en=+w.dataset.en,a=easeOut(prog(local,st,.12))*(1-easeOut(prog(local,en-.05,.14)));w.style.opacity=easeOut(prog(local,st,.3));w.style.transform=`translateY(${-6*a}px) scale(${1+.07*a})`;w.style.color=w.dataset.gold?'#e9c46a':`rgb(${Math.round(255-22*a)},${Math.round(248-52*a)},${Math.round(230-124*a)})`;w.style.textShadow=`0 0 ${34*a}px #e9c46a`});}
else {$('caption').style.opacity=0;['arabic','cards','number','badgeWrap','closeEmojis','screenArabic','screenCards','screenNumber','screenBadge','screenClose'].forEach(id=>{let e=$(id);if(e)e.style.display='none'})}
let brandIndex=scenes.findIndex(x=>/ইসলামী বিশ্বকোষ ও আল হাদিস S2/.test(x.text)), brandEnd=brandIndex>=0?scenes[brandIndex].end:5.6;
let intro=easeBack(prog(t,0,.9)), shr=easeInOut(prog(t,brandEnd,.7)), finalStart=scenes.length>1?scenes[scenes.length-2].start:47, grow=easeInOut(prog(t,finalStart,.8));
let scale=.2+(intro*.8);if(t>brandEnd)scale=1-.38*shr;if(t>=finalStart)scale=.62+.38*grow;
let logoVisible=theme==='infographic'||(brandIndex>=0&&t>=scenes[brandIndex].start-.01);
if(theme==='podcast'){scale=.2+.8*easeBack(prog(t,brandIndex>=0?scenes[brandIndex].start:0,.9));if(t>brandEnd)scale=1-.5*easeInOut(prog(t,brandEnd-.4,.7));if(scenes.length&&t>=scenes[scenes.length-1].start)scale=.78}
$('logo').style.opacity=logoVisible?clamp(prog(t,0,.5)):0;$('logo').style.transform=`translateX(-50%) scale(${scale*(1+.016*lv)})`;if(theme==='podcast'){$('logo').style.left=t>=brandEnd?'210px':'550px';$('logo').style.top=t>=brandEnd?'55px':'270px';$('logo').style.transform=`translateX(-50%) scale(${scale})`;if(scenes.length&&t>=scenes[scenes.length-1].start){$('logo').style.left='550px';$('logo').style.top='250px'}}
$('ripple').style.opacity=clamp(1-Math.abs(((t-.6)%1.4)/1.4));$('ripple').style.transform=`translate(-50%,-50%) scale(${.2+clamp((t-.6)/1.4)*1.4})`;
$('progressIn').style.width=clamp(t/duration)*100+'%';$('stars').style.transform=`translate(-50%,-50%) rotate(${t*2.2}deg)`;$('stars').style.opacity=.13+.07*lv;$('glow').style.opacity=.72+.28*lv;
particles.forEach((p,i)=>{let w=theme==='podcast'?1920:1080,h=theme==='podcast'?1080:1920;p.style.left=((i*(theme==='podcast'?211:97)+Math.sin(.4*t+i)*40)%w)+'px';p.style.top=(h-((t*(20+(i%7)*9)+i*131)%(h+60)))+'px';p.style.opacity=clamp(.25+.2*lv+.2*Math.sin(t+i))});
bars.forEach((b,i)=>{let wave=.5+.5*Math.abs(Math.sin(6*t+.7*i)),shape=.65+.35*Math.sin(.45*i+1);b.style.height=(4+(theme==='podcast'?22:40)*clamp(lv*1.15*wave*shape+.04))+'px'});
$('panel').style.setProperty('--ang',t*90+'deg');$('panel').style.boxShadow=`0 0 ${24+80*lv}px rgba(var(--mood),${.22+.45*lv})`;if(theme==='podcast'){$('screen').style.boxShadow=`0 0 ${24+70*lv}px rgba(var(--mood),.35)`;$('onair').style.boxShadow=`0 0 ${15+40*lv}px rgba(var(--mood),.4)`;$('onairDot').style.opacity=sp?(.5+.5*Math.sin(t*7)):0.2;
let m=sp*(.3+.7*Math.abs(Math.sin(t*13)))*(.75+.25*lv);$('mouth').setAttribute('transform',`translate(290 360) scale(${1+.18*m} ${.1+.9*m}) translate(-290 -360)`);$('head').setAttribute('transform',`translate(0 ${Math.sin(1.7*t)*1.5-3.5*m}) rotate(${Math.sin(.8*t)*1.4+sp*Math.sin(2.3*t)*.9} 290 330)`);$('torso').setAttribute('transform',`translate(0 ${Math.sin(1.6*t)*2.2+3*lv*sp})`);$('rightArm').setAttribute('transform',`rotate(${-5-36*sp*(.35+.65*(.5+.5*Math.sin(1.1*t))*(.5+.5*lv))} 430 460)`)}
}
window.init=init;window.fit=fit;window.seek=seek;window.setAudio=setAudio;
})();
